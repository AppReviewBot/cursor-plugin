{
  "name": "appreviewbot-cursor-plugin",
  "version": "1.0.3",
  "private": true,
  "description": "Cursor Marketplace plugin for AppReviewBot — MCP + skills for app store reviews.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "test": "vitest run && pnpm test:oauth-helper",
    "test:oauth-helper": "node --test scripts/oauth-pkce-security.test.mjs",
    "test:watch": "vitest",
    "validate": "tsx ./src/validate-cli.ts",
    "smoke": "tsx ./src/smoke-cli.ts",
    "oauth:test": "node ./scripts/oauth-pkce-flow.mjs",
    "check:auth": "node ./scripts/check-cursor-mcp-auth.mjs",
    "install:local": "node ./scripts/install-local.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.19.8",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}

